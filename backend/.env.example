# =============================================================================
# Variables de entorno del backend de SIGEV
# Copia este archivo como .env y completa los valores. El .env NUNCA se sube al repo.
# =============================================================================

# --- Base de datos (Supabase) ---------------------------------------------------
# Usa los datos del "Session/Transaction pooler" de Supabase (Connect -> Direct),
# no la conexión directa: esa solo funciona con IPv6.
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=<contraseña-de-la-base>
# Supabase exige conexión cifrada
DB_SSL=true

# --- Alternativa: PostgreSQL local (por ejemplo en Docker) ----------------------
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sigev_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_SSL=false

# --- Servidor -------------------------------------------------------------------
PORT=3000

# Umbral de asistentes (P-05, RN-03): con más asistentes que este número se avisa que probablemente
# haya que alquilar mobiliario. Si no se define, se usa 200. Cambiarlo requiere reiniciar el servidor.
MAX_OWNED_CAPACITY_THRESHOLD=200

# Sitios que pueden llamar a la API (opcional, separados por comas). Sin definirla acepta cualquiera.
# En producción conviene poner la dirección del frontend, por ejemplo:
# CORS_ORIGIN=https://sigev-nine.vercel.app,http://localhost:5173

# Clave para firmar los tokens de sesión. Usa un texto largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<clave-larga-y-aleatoria>
