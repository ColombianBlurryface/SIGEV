# =============================================================================
# Variables de entorno del backend de SIGEV
# =============================================================================
# Copia este archivo como backend/.env. El .env NUNCA se sube al repositorio.
#
# Por defecto apunta a la base de datos LOCAL (docker compose up -d), así lo que hagas en tu
# computadora no toca QA ni producción. Datos de acceso local: usuario «dev», contraseña «local1234».
# =============================================================================

# --- Base de datos LOCAL (la que levanta docker-compose.yml) --------------------
DB_HOST=localhost
DB_PORT=5433
DB_NAME=sigev_dev
DB_USER=sigev
DB_PASSWORD=sigev
DB_SSL=false

# --- Servidor -------------------------------------------------------------------
PORT=3000

# Clave para firmar los tokens de sesión (cualquier texto largo; es solo para tu computadora). Ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<clave-larga-y-aleatoria-solo-para-local>

# Umbral de asistentes (P-05, RN-03): con más asistentes que este número se avisa que probablemente
# haya que alquilar mobiliario. Si no se define, se usa 200.
MAX_OWNED_CAPACITY_THRESHOLD=200

# =============================================================================
# USAR UNA BASE REMOTA (Supabase de QA) DESDE TU COMPUTADORA — solo si hace falta
# =============================================================================
# Por seguridad, el backend se niega a arrancar en una computadora si DB_HOST no es localhost.
# Para apuntar al Supabase de QA hay que ser explícito:
#
#   DB_HOST=aws-0-<region>.pooler.supabase.com   # Connect → Transaction pooler
#   DB_PORT=6543
#   DB_NAME=postgres
#   DB_USER=postgres.<referencia-del-proyecto-de-QA>
#   DB_PASSWORD=<la contraseña de QA, que te da el equipo por privado>
#   DB_SSL=true
#   PERMITIR_BASE_REMOTA=si
#
# NUNCA pongas aquí los datos de PRODUCCIÓN. Producción solo vive en las variables de entorno de
# Vercel; si necesitas tocarla a propósito, usa un archivo aparte que no sea el .env diario.

# Solo en Vercel (CORS_ORIGIN: sitios que pueden llamar a la API, separados por comas):
# CORS_ORIGIN=https://sigev-nine.vercel.app
